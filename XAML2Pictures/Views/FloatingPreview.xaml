<Window x:Class="Muggle.Xaml2Pictures.Views.FloatingPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Muggle.Xaml2Pictures.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Muggle.Xaml2Pictures.ViewModels"
        Width="300"
        Height="300"
        MinWidth="256"
        MinHeight="256"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Xaml2Pictures.ico"
        PreviewMouseDown="OnPreviewMouseDown"
        PreviewMouseUp="OnPreviewMouseUp"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseWheel="OnPreviewMouseWheel"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:FloatingPreviewViewModel}">
    <Window.Background>
        <ImageBrush ImageSource="/Assets/PreviewBackground.jpg" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,16,16" />
    </Window.Background>

    <Image Margin="5" Stretch="Uniform">
        <Image.Source>
            <DrawingImage Drawing="{Binding DrawingGroup, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
        </Image.Source>
    </Image>
</Window>