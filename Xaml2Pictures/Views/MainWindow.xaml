<Window x:Class="Muggle.Xaml2Pictures.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Muggle.Xaml2Pictures.ViewModels"
        xmlns:res="clr-namespace:Muggle.Xaml2Pictures.Resources"
        xmlns:vc="clr-namespace:Muggle.Xaml2Pictures.ValueConverters"
        Title="Muggle.Xaml2Pictures"
        Width="480"
        Height="480"
        MinWidth="410"
        MinHeight="330"
        Icon="/Assets/Xaml2Pictures.ico"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        d:Width="480"
        d:Height="480">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <vc:BoundsToStringValueConverter x:Key="BoundsToStringValueConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityValueConverter" />

        <DataTemplate x:Key="DrawingGroupDataTemplate" DataType="{x:Type vm:KeyValuePairWrapper}">
            <Grid Width="128">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image Grid.Row="0" Height="128" ToolTip="{Binding Value.Bounds, Converter={StaticResource BoundsToStringValueConverter}}">
                    <Image.Source>
                        <DrawingImage Drawing="{Binding Value}" />
                    </Image.Source>
                </Image>
                <TextBlock Grid.Row="2" HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding Key}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="Element" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="5" />
        </Style>

        <Style TargetType="TextBlock" BasedOn="{StaticResource Element}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource Element}">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource Element}">
            <Setter Property="Padding" Value="0,-3" />
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource Element}" />

        <Style TargetType="ListBox" BasedOn="{StaticResource Element}">
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <SolidColorBrush x:Key="ListBox.Disabled.Background" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ListBox.Disabled.Border" Color="#FFD9D9D9" />
        <ControlTemplate x:Key="DrawingGroupsListBox" TargetType="{x:Type ListBox}">
            <Border x:Name="Bd"
                    Padding="1"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="true">
                <ScrollViewer Padding="{TemplateBinding Padding}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="false">
                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </ScrollViewer>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="false">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListBox.Disabled.Background}" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ListBox.Disabled.Border}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsGrouping" Value="true" />
                        <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="false" />
                    </MultiTrigger.Conditions>
                    <Setter Property="ScrollViewer.CanContentScroll" Value="false" />
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <SolidColorBrush x:Key="TextBox.Border" Color="Red" />
        <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="Red" />
        <SolidColorBrush x:Key="TextBox.Focus.Border" Color="Red" />
        <ControlTemplate x:Key="ExceptionMessageTextBox" TargetType="{x:Type TextBoxBase}">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource TextBox.Border}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="false">
                    <Setter TargetName="border" Property="Opacity" Value="0.56" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource TextBox.MouseOver.Border}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="true">
                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource TextBox.Focus.Border}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

    </Window.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Language.SourceFile}" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding XamlFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="0" Grid.Column="2" Content="..." Command="{Binding SelectXamlFileCommand}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Language.SaveTo}" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DestinationDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="1" Grid.Column="2" Content="..." Command="{Binding SelectDestinationDirectoryCommand}" />
        </Grid>

        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Text="{x:Static res:Language.PictureFormat}" />
            <ComboBox Grid.Column="1" SelectedItem="{Binding EncoderEnum, Mode=TwoWay}" ItemsSource="{x:Static vm:MainWindowViewModel.EncoderSet}" />

            <TextBlock Grid.Column="2" Text="{x:Static res:Language.DPI}" />
            <ComboBox Grid.Column="3" SelectedValue="{Binding Dpi, Mode=TwoWay}" ItemsSource="{x:Static vm:MainWindowViewModel.DpiSet}" />

            <TextBlock Grid.Column="4" Text="{x:Static res:Language.BlankBorderWidth}" />
            <TextBox Grid.Column="5" HorizontalContentAlignment="Center" Text="{Binding BlandBorderThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Orientation="Horizontal">
            <Button Width="120" Height="28" Content="{x:Static res:Language.FloatingPreview}" Command="{Binding ShowFloatingPreviewCommand}" />
            <Button Width="120" Height="28" Content="{x:Static res:Language.Save}" Command="{Binding ConvertDrawingGroupsToPicturesCommand}" />
        </StackPanel>

        <TextBox DockPanel.Dock="Bottom"
                 HorizontalAlignment="Stretch"
                 Template="{StaticResource ExceptionMessageTextBox}"
                 IsReadOnly="True"
                 Text="{Binding ExceptionDuringLoading, Mode=OneWay}"
                 TextWrapping="Wrap"
                 Visibility="{Binding HasExceptionWhenLoading, Converter={StaticResource BoolToVisibilityValueConverter}, Mode=OneWay}"
                 d:Text="Exception example"
                 d:Visibility="Visible">
        </TextBox>

        <ListBox SelectionMode="Extended"
                 SelectionChanged="ListBox_SelectionChanged"
                 Template="{DynamicResource DrawingGroupsListBox}"
                 ItemTemplate="{StaticResource DrawingGroupDataTemplate}"
                 ItemsSource="{Binding DrawingGroups, Mode=OneWay}" />
    </DockPanel>
</Window>