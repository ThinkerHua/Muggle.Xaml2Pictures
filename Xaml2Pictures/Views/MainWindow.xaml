<Window x:Class="Muggle.Xaml2Pictures.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Muggle.Xaml2Pictures.ViewModels"
        xmlns:res="clr-namespace:Muggle.Xaml2Pictures.Resources"
        Title="Muggle.Xaml2Pictures"
        Width="480"
        Height="480"
        MinWidth="410"
        MinHeight="330"
        WindowStartupLocation="CenterScreen"
        d:Width="480"
        d:Height="480"
        mc:Ignorable="d">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>

        <DataTemplate x:Key="DrawingGroupDataTemplate" DataType="{x:Type vm:KeyValuePairWrapper}">
            <Grid Width="128">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image Grid.Row="0" Height="128">
                    <Image.Source>
                        <DrawingImage Drawing="{Binding Value}" />
                    </Image.Source>
                </Image>
                <TextBlock Grid.Row="2" HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding Key}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="Element" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="5" />
        </Style>

        <Style TargetType="TextBlock" BasedOn="{StaticResource Element}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource Element}">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource Element}">
            <Setter Property="Padding" Value="0,-3" />
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource Element}" />

        <Style TargetType="ListBox" BasedOn="{StaticResource Element}">
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <SolidColorBrush x:Key="ListBox.Disabled.Background" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ListBox.Disabled.Border" Color="#FFD9D9D9" />
        <ControlTemplate x:Key="ListBoxTemplate1" TargetType="{x:Type ListBox}">
            <Border x:Name="Bd"
                    Padding="1"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="true">
                <ScrollViewer Padding="{TemplateBinding Padding}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="false">
                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </ScrollViewer>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="false">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListBox.Disabled.Background}" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ListBox.Disabled.Border}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsGrouping" Value="true" />
                        <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="false" />
                    </MultiTrigger.Conditions>
                    <Setter Property="ScrollViewer.CanContentScroll" Value="false" />
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

    </Window.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Language.SourceFile}" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding XamlFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="0" Grid.Column="2" Content="..." Command="{Binding SelectXamlFileCommand}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Language.SaveTo}" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DestinationDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="1" Grid.Column="2" Content="..." Command="{Binding SelectDestinationDirectoryCommand}" />
        </Grid>

        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Text="{x:Static res:Language.PictureFormat}" />
            <ComboBox Grid.Column="1" SelectedItem="{Binding EncoderEnum, Mode=TwoWay}" ItemsSource="{Binding EncoderSet}" />

            <TextBlock Grid.Column="2" Text="{x:Static res:Language.DPI}" />
            <ComboBox Grid.Column="3" SelectedValue="{Binding Dpi, Mode=TwoWay}" ItemsSource="{Binding DpiSet}" />

            <TextBlock Grid.Column="4" Text="{x:Static res:Language.BlankBorderWidth}" />
            <TextBox Grid.Column="5" HorizontalContentAlignment="Center" Text="{Binding BlandBorderWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Button Width="120"
                Height="28"
                DockPanel.Dock="Bottom"
                Content="{x:Static res:Language.Action}"
                Command="{Binding ConvertDrawingGroupsToPicturesCommand}" />

        <ListBox SelectionMode="Extended"
                 SelectionChanged="ListBox_SelectionChanged"
                 Template="{DynamicResource ListBoxTemplate1}"
                 ItemTemplate="{StaticResource DrawingGroupDataTemplate}"
                 ItemsSource="{Binding DrawingGroups, Mode=OneWay}" />
    </DockPanel>
</Window>